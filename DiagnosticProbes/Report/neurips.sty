\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2024}[2024/01/01 NeurIPS 2024 submission/camera-ready style file]

% --- OPTIONS ---
\newif\if@neuripsfinal\@neuripsfinalfalse
\newif\if@neuripspreprint\@neuripspreprintfalse
\DeclareOption{final}{\@neuripsfinaltrue}
\DeclareOption{preprint}{\@neuripspreprinttrue}
\ProcessOptions\relax

% --- PACKAGES AND MARGINS ---
\RequirePackage{geometry}
\geometry{
  letterpaper,
  textwidth=5.5in,
  textheight=9in,
  marginparsep=11pt,
  marginparwidth=1.07in,
  vmargin=1in,
  hmargin=1.5in
}

% --- FONTS AND SPACING ---
\renewcommand{\topfraction}{0.95}
\renewcommand{\bottomfraction}{0.95}
\renewcommand{\textfraction}{0.05}
\renewcommand{\floatpagefraction}{0.9}
\flushbottom
\linespread{1.0}

% --- ABSTRACT FORMATTING ---
\renewenvironment{abstract}
  {\par\begin{center}\large\textbf{Abstract}\end{center}\vspace{-0.5em}\noindent\ignorespaces}
  {\par\vspace{1em}}


% --- TITLE FORMATTING ---
\def\maketitle{\par
  \begingroup
    \def\thefootnote{\fnsymbol{footnote}}
    \def\@makefnmark{\hbox to \z@{$\m@th^{\@thefnmark}$\hss}}
    \long\def\@makefntext##1{\parindent 1em\noindent
      \hbox to 1.8em{\hss $\m@th^{\@thefnmark}$}##1}
    \@maketitle \@thanks
  \endgroup
  \setcounter{footnote}{0}
  \let\maketitle\relax \let\@maketitle\relax
  \gdef\@thanks{}\gdef\@author{}\gdef\@title{}
}

\def\@maketitle{\vbox{\hsize\textwidth
    \linewidth\hsize \vskip 0.1in \trivlist \item \centering
    {\LARGE\bf \@title \par} \vskip 0.25in
    \def\And{\end{tabular}\hfil\linebreak[0]\hfil
      \begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\ignorespaces}
    \def\AND{\end{tabular}\hfil\linebreak[4]\hfil
      \begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\ignorespaces}
    \begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\@author\end{tabular}
    \vskip 0.3in \@minus 0.1in \endtrivlist}}

% --- PREPRINT / FINAL HEADERS ---
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{} % clear all
\renewcommand{\headrulewidth}{0pt}
\if@neuripsfinal
  % Final version has no headers/footers
  \pagestyle{empty}
\else
  \if@neuripspreprint
    \fancyfoot[C]{\small Preprint. Under review.}
  \else
    \fancyfoot[C]{\small Submitted to the 38th Conference on Neural Information Processing Systems (NeurIPS 2024). Do not distribute.}
  \fi
\fi